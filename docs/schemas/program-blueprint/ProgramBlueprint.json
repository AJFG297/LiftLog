{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 3
    },
    "name": {
      "type": "string",
      "description": "Name of the workout program; typically matches the plan name."
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SessionBlueprint"
      }
    },
    "lastEdited": {
      "$ref": "#/definitions/LocalDate"
    }
  },
  "required": [
    "version",
    "name",
    "sessions",
    "lastEdited"
  ],
  "definitions": {
    "SessionBlueprint": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 7
        },
        "name": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExerciseBlueprint"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "name",
        "exercises",
        "notes"
      ]
    },
    "ExerciseBlueprint": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/definitions/WeightedExerciseBlueprint"
        },
        {
          "$ref": "#/definitions/CardioExerciseBlueprint"
        }
      ]
    },
    "WeightedExerciseBlueprint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "WeightedExerciseBlueprint"
        },
        "name": {
          "type": "string"
        },
        "plannedSets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlannedSet"
          },
          "description": "What the plan asks for, one entry per set."
        },
        "restBetweenSets": {
          "$ref": "#/definitions/Rest"
        },
        "supersetWithNext": {
          "type": "boolean",
          "description": "When true, this exercise is performed back-to-back with the following one (a superset), with no rest in between."
        },
        "notes": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "description": "A url to some explanation of how to do this. We should not fill this unless the user has explicitly given us a link to fill"
        },
        "progression": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProgressionRule"
          },
          "description": "Ordered; the first rule that can still move, moves. Empty means no automatic progression."
        },
        "resistance": {
          "$ref": "#/definitions/Resistance",
          "description": "Where this movement's load comes from: the whole stored weight (`external`), what is added on top of the lifter (`bodyweight`), or nothing at all (`none`, e.g. crunches)."
        },
        "warmupSets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlannedWarmupSet"
          },
          "description": "Sets done before the working sets that never count toward progression, records or stats. Kept apart from `plannedSets` so everything reading working sets leaves them out without a filter."
        }
      },
      "required": [
        "type",
        "name",
        "plannedSets",
        "restBetweenSets",
        "supersetWithNext",
        "notes",
        "link",
        "progression",
        "resistance",
        "warmupSets"
      ]
    },
    "PlannedSet": {
      "type": "object",
      "properties": {
        "reps": {
          "$ref": "#/definitions/RepsTarget"
        }
      },
      "required": [
        "reps"
      ],
      "description": "What the plan asks for on one set."
    },
    "RepsTarget": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "description": "Always a band; `min === max` is a point target."
    },
    "Rest": {
      "type": "object",
      "properties": {
        "minRest": {
          "$ref": "#/definitions/Duration"
        },
        "maxRest": {
          "$ref": "#/definitions/Duration"
        },
        "failureRest": {
          "$ref": "#/definitions/Duration",
          "description": "Rest taken after a set where the user failed to hit their target reps."
        }
      },
      "required": [
        "minRest",
        "maxRest",
        "failureRest"
      ]
    },
    "Duration": {
      "type": "string",
      "format": "duration"
    },
    "ProgressionRule": {
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/definitions/ProgressionAxis"
        },
        "step": {
          "$ref": "#/definitions/BigNumber"
        },
        "scope": {
          "$ref": "#/definitions/SetScope"
        },
        "ceiling": {
          "$ref": "#/definitions/BigNumber",
          "description": "Where the axis stops climbing. Above this the rule can no longer move, so the next one is tried."
        },
        "onCeiling": {
          "type": "string",
          "const": "reset",
          "description": "Drop the axis back to what the plan asks for once a later rule fires."
        },
        "trigger": {
          "$ref": "#/definitions/SuccessRule"
        }
      },
      "required": [
        "axis",
        "step",
        "scope",
        "trigger"
      ],
      "description": "One step of automatic progression. An exercise carries an ordered list of these, and the first rule that can still move is the one that moves.\n\n`step` and `ceiling` are in the axis's own unit - whole reps, or plate increments in whatever unit the lifter works in. Deliberately not a weight: 2.5 in a kilogram gym and 5 in a pound gym are the same step, not conversions of one another, and a blueprint has no unit to be expressed in."
    },
    "ProgressionAxis": {
      "type": "string",
      "enum": [
        "reps",
        "load"
      ],
      "description": "Which number a rule moves."
    },
    "BigNumber": {
      "type": "string",
      "examples": [
        "1.23"
      ],
      "format": "decimal"
    },
    "SetScope": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/definitions/AllSetsScope"
        },
        {
          "$ref": "#/definitions/LowestSetsScope"
        }
      ],
      "description": "Which sets a rule moves."
    },
    "AllSetsScope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "allSets"
        }
      },
      "required": [
        "type"
      ]
    },
    "LowestSetsScope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lowestSets"
        },
        "pick": {
          "type": "string",
          "enum": [
            "first",
            "middle",
            "last",
            "all"
          ]
        }
      },
      "required": [
        "type",
        "pick"
      ],
      "description": "Ranks by the rule's own axis, so a reps rule picks the smallest target rather than the smallest weight."
    },
    "SuccessRule": {
      "type": "string",
      "const": "allSetsMetTarget",
      "description": "What has to happen for a rule to fire."
    },
    "Resistance": {
      "type": "string",
      "enum": [
        "none",
        "external",
        "bodyweight"
      ]
    },
    "PlannedWarmupSet": {
      "type": "object",
      "properties": {
        "load": {
          "$ref": "#/definitions/WarmupLoad",
          "description": "Absent for an exercise with no resistance, where a warm-up is reps only. A bodyweight exercise only takes an absolute (added) weight."
        },
        "reps": {
          "type": "integer"
        }
      },
      "required": [
        "reps"
      ],
      "description": "What the plan asks for on one warm-up set."
    },
    "WarmupLoad": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/definitions/PercentWarmupLoad"
        },
        {
          "$ref": "#/definitions/AbsoluteWarmupLoad"
        }
      ]
    },
    "PercentWarmupLoad": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "percent"
        },
        "percent": {
          "type": "number",
          "description": "Out of 100, so `50` is half the working weight."
        }
      },
      "required": [
        "type",
        "percent"
      ],
      "description": "A share of the session's heaviest working set, rounded to the exercise's weight increment."
    },
    "AbsoluteWarmupLoad": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "absolute"
        },
        "weight": {
          "$ref": "#/definitions/Weight"
        }
      },
      "required": [
        "type",
        "weight"
      ],
      "description": "A fixed weight, such as an empty bar. The one place a blueprint carries a unit: it is a real load, not a plate increment, so it is converted into whatever unit the session is in."
    },
    "Weight": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/definitions/WeightUnit"
        },
        "value": {
          "$ref": "#/definitions/BigNumber"
        }
      },
      "required": [
        "unit",
        "value"
      ]
    },
    "WeightUnit": {
      "type": "string",
      "enum": [
        "kilograms",
        "pounds",
        "nil"
      ]
    },
    "CardioExerciseBlueprint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "CardioExerciseBlueprint"
        },
        "name": {
          "type": "string"
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardioExerciseSetBlueprint"
          }
        },
        "notes": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "sets",
        "notes",
        "link"
      ]
    },
    "CardioExerciseSetBlueprint": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/CardioTarget"
        },
        "trackDuration": {
          "type": "boolean"
        },
        "trackDistance": {
          "type": "boolean"
        },
        "trackResistance": {
          "type": "boolean"
        },
        "trackIncline": {
          "type": "boolean"
        },
        "trackWeight": {
          "type": "boolean"
        },
        "trackSteps": {
          "type": "boolean"
        },
        "restBetweenSets": {
          "$ref": "#/definitions/Rest",
          "description": "Absent when the set has no rest - steady-state cardio does not need one."
        }
      },
      "required": [
        "target",
        "trackDuration",
        "trackDistance",
        "trackResistance",
        "trackIncline",
        "trackWeight",
        "trackSteps"
      ]
    },
    "CardioTarget": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/definitions/TimeCardioTarget"
        },
        {
          "$ref": "#/definitions/DistanceCardioTarget"
        }
      ]
    },
    "TimeCardioTarget": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "time"
        },
        "value": {
          "$ref": "#/definitions/Duration"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "DistanceCardioTarget": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "distance"
        },
        "value": {
          "$ref": "#/definitions/Distance"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "Distance": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/BigNumber"
        },
        "unit": {
          "$ref": "#/definitions/DistanceUnit"
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "DistanceUnit": {
      "type": "string",
      "enum": [
        "metre",
        "yard",
        "mile",
        "kilometre"
      ]
    },
    "LocalDate": {
      "type": "string",
      "format": "date"
    }
  }
}