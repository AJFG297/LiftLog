{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "RecordedWeightedExercise"
    },
    "blueprint": {
      "$ref": "./WeightedExerciseBlueprint.json"
    },
    "potentialSets": {
      "type": "array",
      "items": {
        "$ref": "./PotentialSet.json"
      },
      "description": "Working sets only; warm-ups live in `warmupSets`."
    },
    "warmupSets": {
      "type": "array",
      "items": {
        "$ref": "./PotentialSet.json"
      },
      "description": "One slot per planned warm-up, rebuilt from the plan every session. Never carries an RPE."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "blueprint",
    "potentialSets",
    "warmupSets"
  ]
}