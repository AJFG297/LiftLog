{
  "expo": {
    "name": "LiftLog",
    "slug": "liftlog",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#fcfdf6",
    "primaryColor": "#046F03",
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": false,
          "NSHealthUpdateUsageDescription": "LiftLog would like to share your workout and/or body weight with Apple Health.",
          "background": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "./plugins/override-health-connect-min-version.js",
      "./plugins/android-signing.js",
      "./plugins/android-gradle-properties.js",
      "./plugins/android-react-native-feature-flags.js",
      "./plugins/android-nav-bar-contrast.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png"
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcfdf6",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  { "path": "@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf", "weight": 400 },
                  { "path": "@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf", "weight": 500 },
                  { "path": "@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf", "weight": 600 },
                  { "path": "@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Geist Mono",
                "fontDefinitions": [
                  { "path": "@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf", "weight": 500 },
                  { "path": "@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf", "weight": 600 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
              "@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
              "@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
              "@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf",
              "@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf",
              "@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "scheme": "liftlog",
    "android": {
      "versionCode": "project.hasProperty('BUILD_NUMBER') ? project.property('BUILD_NUMBER').toInteger() : 1",
      "version": "${project.hasProperty('DISPLAY_VERSION') ? project.property('DISPLAY_VERSION') : \"1.0.0\"}",
      "package": "com.limajuice.liftlog",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_EXERCISE_ROUTE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.liftlog.online"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "content", "mimeType": "application/json" },
            { "scheme": "content", "mimeType": "text/plain" },
            { "scheme": "file", "mimeType": "application/octet-stream" },
            { "scheme": "file", "mimeType": "application/json" },
            { "scheme": "file", "mimeType": "text/plain" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\.liftlogplan" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\.liftlogplan" }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#dfedda",
        "foregroundImage": "./assets/icon_foreground.png",
        "monochromeImage": "./assets/icon_monochrome.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.limajuice.liftlog",
      "associatedDomains": ["applinks:app.liftlog.online"],
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "LiftLog Plan",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.limajuice.liftlog.plan"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.limajuice.liftlog.plan",
            "UTTypeDescription": "LiftLog Plan",
            "UTTypeConformsTo": ["public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["liftlogplan"]
            }
          }
        ],
        "CFBundleLocalizations": [
          "ar",
          "cs",
          "de",
          "en",
          "es",
          "fi",
          "fr",
          "hu",
          "it",
          "ko",
          "nl",
          "pl",
          "pt",
          "ru",
          "sr",
          "sv",
          "tr",
          "uk",
          "zh-hans"
        ]
      },
      "appleTeamId": "",
      "version": "$(APP_DISPLAY_VERSION)",
      "buildNumber": "$(APP_VERSION)"
    }
  }
}
